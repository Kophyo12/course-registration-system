# Copy this file to server/.env and fill in your own values.
# Never commit server/.env.

# Port the API runs on (the client expects 5001)
PORT=5001

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Any long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Optional: the website address allowed by CORS (default http://localhost:5173)
# CLIENT_URL=http://localhost:5173
